vaani.shubhamiitbhu.in {
	encode zstd gzip
	root * /home/ubuntu/vaani/apps/studio/dist
	try_files {path} /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

vaani-api.shubhamiitbhu.in {
	encode zstd gzip

	@stt path /v1/audio/transcriptions*
	handle @stt {
		reverse_proxy 127.0.0.1:8002 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
}
