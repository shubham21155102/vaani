# Server-side env — used by the FastAPI service via systemd EnvironmentFile.
# DO NOT commit the real .env file (it's in .gitignore).
# On the production box, generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

VAANI_JWT_SECRET=replace-with-64-byte-random-secret
VAANI_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
